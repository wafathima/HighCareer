{
  "name": "highcareer",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered career management platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@highcareer/web",
    "dev:api": "npm run dev --workspace=@highcareer/api",
    "build": "npm run build --workspaces --if-present"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
